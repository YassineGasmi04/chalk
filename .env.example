# Copy this file to .env and fill it in. Never commit .env.
#
# Microsoft Foundry (recommended): in the Foundry portal open your project,
# deploy a model (e.g. gpt-4.1-mini), then copy the endpoint and key.
CHALK_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
CHALK_API_KEY=paste-your-key-here
CHALK_MODEL=gpt-4.1-mini
# optional: parallel model calls (lower it if you hit rate limits)
CHALK_MAX_CONCURRENCY=3
# optional: a stronger deployment just for the VAR fact-checker (e.g. gpt-4.1)
# CHALK_VAR_MODEL=gpt-4.1
